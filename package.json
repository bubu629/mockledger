{
  "name": "dataforge-studio",
  "version": "1.0.0",
  "private": true,
  "description": "DataForge \u2014 100% Local Business Process & E-Commerce Reconciliation Data Factory",
  "bin": "dist/bundle.cjs",
  "scripts": {
    "keygen": "tsx scripts/keygen.ts",
    "dev": "tsx src/main.ts",
    "cli": "tsx src/cli.ts",
    "test": "vitest run",
    "bundle": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/bundle.cjs --minify",
    "build:all": "npm run bundle && npx @yao-pkg/pkg .",
    "build:sea-win": "npm run bundle && node --build-sea sea-config.win.json"
  },
  "pkg": {
    "targets": [
      "node20-win-x64",
      "node20-macos-arm64",
      "node20-macos-x64",
      "node20-linux-x64"
    ],
    "outputPath": "release"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "commander": "^12.1.0",
    "csv-stringify": "^6.5.1",
    "fastify": "^4.28.1",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.13.4",
    "@yao-pkg/pkg": "^5.11.5",
    "esbuild": "^0.21.5",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}